{
  "name": "@local/dsh-reboot-button",
  "version": "1.0.0",
  "type": "module",
  "description": "Restart action in the Settings header that relaunches the DeepSeek Harness desktop application.",
  "keywords": ["dsh-plugin", "settings", "restart"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "relaunch.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
